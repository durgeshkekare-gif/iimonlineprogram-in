{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/programs",
      "destination": "/programs/index.html"
    },
    {
      "source": "/iim-nagpur",
      "destination": "/iim-nagpur/index.html"
    },
    {
      "source": "/iim-ahmedabad",
      "destination": "/iim-ahmedabad/index.html"
    },
    {
      "source": "/iim-kozhikode",
      "destination": "/iim-kozhikode/index.html"
    },
    {
      "source": "/iim-trichy",
      "destination": "/iim-trichy/index.html"
    },
    {
      "source": "/iim-mumbai",
      "destination": "/iim-mumbai/index.html"
    },
    {
      "source": "/iim-indore",
      "destination": "/iim-indore/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}